FROM docker.io/library/python:3.14-slim

# valorizzata dalla CI (X.Y.Z sui tag, main-<sha> su main); "dev" nelle build manuali
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION

WORKDIR /opt/ristruttura730
RUN pip install --no-cache-dir fastapi "uvicorn[standard]"
COPY app ./app

ENV DB_PATH=/data/app.db
VOLUME /data
EXPOSE 8730

# niente curl nell'immagine slim: basta la stdlib (urlopen solleva eccezione se non-200)
HEALTHCHECK --interval=60s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8730/api/health', timeout=4)"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8730"]
