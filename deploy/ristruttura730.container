# Quadlet podman — copiare in ~/.config/containers/systemd/ristruttura730.container
# poi: systemctl --user daemon-reload && systemctl --user start ristruttura730
# Guida completa: deploy/podman.md
[Unit]
Description=Ristruttura730 - tracker spese ristrutturazione e detrazioni
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/purpleturtle73/ristruttura730:latest
AutoUpdate=registry
ContainerName=ristruttura730
# solo per immagine privata: credenziali create con `podman login --authfile` (vedi guida)
#Environment=REGISTRY_AUTH_FILE=%h/.config/containers/auth.json
# raggiungibile dalla LAN/VPN (l'app non ha autenticazione: ok solo su reti fidate):
PublishPort=8730:8730

Volume=<PATH_TO_DATA_DIR>/data:/data:Z
Environment=DB_PATH=/data/app.db
# opzionali (default: 24 e 5)
#Environment=BACKUP_INTERVAL_HOURS=24
#Environment=BACKUP_MAX_AGE_DAYS=5
# Health check
HealthCmd=/bin/sh -c 'curl -f http://localhost:8730/api/health'
HealthStartPeriod=30s
HealthInterval=10s
HealthTimeout=10s
HealthRetries=120

[Service]
Restart=always
TimeoutStartSec=30

[Install]
WantedBy=default.target
